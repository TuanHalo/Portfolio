---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import ResumeLayout from '@/layouts/ResumeLayout.astro';
import {
  getCertificates,
  getEducation,
  getExperience,
  getProfile,
  getSkills,
} from '@/lib/content';
import { formatMonthYear } from '@/lib/dates';
import { withBase } from '@/lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [profile, experience, education, skills, certificates] = await Promise.all([
  getProfile(),
  getExperience(),
  getEducation(),
  getSkills(),
  getCertificates(),
]);

const pdfHref = withBase(`/resume/resume-${lang}.pdf`);
---

<ResumeLayout
  lang={lang}
  title={`${t('resume.title')} — ${profile.name}`}
  description={profile.tagline[lang]}
>
  <div class="no-print mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-tight text-[var(--color-fg)]">{t('resume.title')}</h1>
    <div class="flex gap-2 text-xs font-medium">
      <a
        href={pdfHref}
        download={`resume-${lang}.pdf`}
        class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-white transition hover:bg-[var(--color-accent-hover)]"
      >
        {t('resume.download')} ⬇
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="rounded-full border border-[var(--color-border)] bg-[var(--color-tile)] px-4 py-2 text-[var(--color-fg)] transition hover:border-[var(--color-accent)] cursor-pointer"
      >
        {t('resume.print')}
      </button>
    </div>
  </div>

  <article class="bento-tile p-8 sm:p-10 print:border-none print:shadow-none print:p-0">
    <header class="border-b border-[var(--color-border)] pb-5">
      <h2 class="text-3xl font-bold tracking-tight text-[var(--color-fg)]">{profile.name}</h2>
      <p class="mt-1 text-base font-medium text-[var(--color-accent)]">{profile.title[lang]}</p>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[var(--color-muted)]">
        <span>{profile.location[lang]}</span>
        <span>·</span>
        <span>{profile.email}</span>
        {
          profile.socials.github && (
            <>
              <span>·</span>
              <span>{profile.socials.github}</span>
            </>
          )
        }
      </div>
    </header>

    <section class="mt-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">
        {t('resume.summary')}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg)]">{profile.bio[lang]}</p>
    </section>

    <section class="mt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">
        {t('resume.experience')}
      </h3>
      <div class="mt-3 space-y-4">
        {
          experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <span class="font-semibold text-[var(--color-fg)]">{job.data.role[lang]}</span>
                  <span class="text-sm text-[var(--color-muted)]"> · {job.data.company}</span>
                </div>
                <span class="text-xs text-[var(--color-muted)]">
                  {formatMonthYear(job.data.start, lang)} —{' '}
                  {job.data.end ? formatMonthYear(job.data.end, lang) : t('experience.present')}
                </span>
              </div>
              <ul class="mt-1.5 list-disc space-y-1 pl-4 text-xs leading-relaxed text-[var(--color-muted)]">
                {job.data.highlights[lang].map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">
        {t('resume.education')}
      </h3>
      <div class="mt-3 space-y-3">
        {
          education.map((edu) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <span class="font-semibold text-[var(--color-fg)]">{edu.data.degree[lang]}</span>
                  <span class="text-sm text-[var(--color-muted)]">
                    {' '}
                    · {edu.data.institution[lang]}
                  </span>
                </div>
                <span class="text-xs text-[var(--color-muted)]">
                  {formatMonthYear(edu.data.start, lang)} —{' '}
                  {edu.data.end ? formatMonthYear(edu.data.end, lang) : t('experience.present')}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">
        {t('resume.skills')}
      </h3>
      <div class="mt-2 space-y-1.5 text-xs">
        {
          skills.map((group) => (
            <div>
              <strong class="text-[var(--color-fg)]">{group.data.category[lang]}: </strong>
              <span class="text-[var(--color-muted)]">{group.data.items.join(', ')}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">
        {t('resume.certificates')}
      </h3>
      <ul class="mt-2 list-disc space-y-1 pl-4 text-xs text-[var(--color-muted)]">
        {
          certificates.map((cert) => (
            <li>
              <strong class="text-[var(--color-fg)]">{cert.data.name[lang]}</strong> —{' '}
              {cert.data.issuer} ({formatMonthYear(cert.data.date, lang)})
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</ResumeLayout>

