---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProfile } from '@/lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile();

const socialLinks = [
  { name: 'GitHub', url: profile.socials.github },
  { name: 'LinkedIn', url: profile.socials.linkedin },
  { name: 'Facebook', url: profile.socials.facebook },
  { name: 'X', url: profile.socials.x },
  { name: 'Website', url: profile.socials.website },
].filter((item) => item.url.length > 0);

const hasZaloOrPhone = profile.socials.zalo.length > 0 || profile.phone.length > 0;
const zaloOrPhoneHref =
  profile.socials.zalo.length > 0 ? profile.socials.zalo : `tel:${profile.phone}`;
const zaloOrPhoneLabel = profile.phone.length > 0 ? profile.phone : 'Zalo';
---

<BaseLayout
  lang={lang}
  title={`${t('contact.title')} — ${profile.name[lang]}`}
  description={t('contact.subtitle')}
>
  <div class="mx-auto max-w-2xl space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--color-fg)]">
        {t('contact.title')}
      </h1>
      <p class="mt-2 text-sm text-[var(--color-muted)]">{t('contact.subtitle')}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href={`mailto:${profile.email}`}
        class:list={[
          'bento-tile flex flex-col justify-between p-6',
          !hasZaloOrPhone && 'sm:col-span-2',
        ]}
      >
        <span class="text-xs font-medium text-[var(--color-muted)]">{t('contact.email')}</span>
        <span class="mt-2 text-lg font-semibold text-[var(--color-accent)]">{profile.email} ↗</span>
      </a>

      {
        hasZaloOrPhone && (
          <a
            href={zaloOrPhoneHref}
            target={profile.socials.zalo.length > 0 ? '_blank' : undefined}
            rel={profile.socials.zalo.length > 0 ? 'noopener noreferrer' : undefined}
            class="bento-tile flex flex-col justify-between p-6"
          >
            <span class="text-xs font-medium text-[var(--color-muted)]">
              {t('contact.zaloPhone')}
            </span>
            <span class="mt-2 text-lg font-semibold text-[var(--color-accent)]">
              {zaloOrPhoneLabel} ↗
            </span>
          </a>
        )
      }

      {
        socialLinks.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bento-tile flex items-center justify-between p-5"
          >
            <span class="font-medium text-[var(--color-fg)]">{item.name}</span>
            <span class="text-sm text-[var(--color-muted)]">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

