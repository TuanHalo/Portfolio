---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProfile, getSkills } from '@/lib/content';
import { withBase } from '@/lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [profile, skillGroups] = await Promise.all([getProfile(), getSkills()]);
---

<BaseLayout lang={lang} title={`${t('about.title')} — ${profile.name}`} description={profile.tagline[lang]}>
  <div class="space-y-8">
    <section class="bento-tile p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <img
          src={withBase(profile.avatar)}
          alt={profile.name}
          width="88"
          height="88"
          class="h-22 w-22 rounded-full object-cover ring-2 ring-[var(--color-border)]"
        />
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-[var(--color-fg)]">{profile.name}</h1>
          <p class="mt-1 text-base font-medium text-[var(--color-accent)]">{profile.title[lang]}</p>
          <div class="mt-2 flex flex-wrap gap-3 text-xs text-[var(--color-muted)]">
            <span>{t('about.location')}: <strong class="text-[var(--color-fg)]">{profile.location[lang]}</strong></span>
            <span>·</span>
            <span>{t('about.availability')}: <strong class="text-emerald-600 dark:text-emerald-400">{profile.availability[lang]}</strong></span>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-3 text-base leading-relaxed text-[var(--color-fg)]">
        {
          profile.bio[lang]
            .trim()
            .split(/\n+/)
            .map((paragraph) => <p>{paragraph}</p>)
        }
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-bold tracking-tight text-[var(--color-fg)]">{t('about.skills')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          skillGroups.map((group) => (
            <div class="bento-tile p-5">
              <h3 class="text-sm font-semibold text-[var(--color-fg)]">
                {group.data.category[lang]}
              </h3>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {group.data.items.map((item) => (
                  <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1 text-xs font-medium text-[var(--color-fg)]">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

