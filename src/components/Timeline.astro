---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { formatMonthYear } from '@/lib/dates';

export interface TimelineEntry {
  readonly title: string;
  readonly organization: string;
  readonly start: Date;
  readonly end?: Date;
  readonly location?: string;
  readonly highlights?: readonly string[];
  readonly stack?: readonly string[];
}

interface Props {
  lang: Lang;
  items: readonly TimelineEntry[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<ol class="relative space-y-6 border-l-2 border-[var(--color-border)] pl-6">
  {
    items.map((item) => (
      <li class="relative">
        <span
          class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-[var(--color-tile)] bg-[var(--color-accent)]"
          aria-hidden="true"
        />
        <div class="bento-tile p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h3 class="text-base font-semibold text-[var(--color-fg)]">{item.title}</h3>
              <p class="text-sm font-medium text-[var(--color-accent)]">{item.organization}</p>
            </div>
            <div class="text-right text-xs text-[var(--color-muted)]">
              <div>
                {formatMonthYear(item.start, lang)} —{' '}
                {item.end ? formatMonthYear(item.end, lang) : t('experience.present')}
              </div>
              {item.location && <div class="mt-0.5">{item.location}</div>}
            </div>
          </div>

          {item.highlights && item.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1.5 pl-4 text-sm text-[var(--color-muted)]">
              {item.highlights.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}

          {item.stack && item.stack.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {item.stack.map((tech) => (
                <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-0.5 text-xs text-[var(--color-fg)]">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

