---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  isFallback?: boolean;
  translation?: 'human' | 'machine';
}

const { lang, isFallback = false, translation = 'human' } = Astro.props;
const t = useTranslations(lang);
---

{
  (isFallback || (lang === 'vi' && translation === 'machine')) && (
    <div
      role="status"
      class="mb-6 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-medium text-amber-900 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200"
    >
      {isFallback ? t('i18n.untranslated') : t('i18n.machineTranslated')}
    </div>
  )
}

