---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '@/i18n/ui';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  summary: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  tags: readonly string[];
  class?: string;
}

const { lang, slug, title, summary, cover, coverAlt, tags, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={localizedPath(lang, `projects/${slug}`)}
  class:list={['bento-tile flex flex-col justify-between p-5', className]}
>
  <div class="flex items-center justify-between text-xs text-[var(--color-muted)]">
    <span>{t('home.featuredProject')}</span>
    <span>{t('home.viewAll')} →</span>
  </div>

  {
    cover ? (
      <div class="my-3 overflow-hidden rounded-xl border border-[var(--color-border)]">
        <Image
          src={cover}
          alt={coverAlt ?? title}
          class="h-36 w-full object-cover"
          loading="eager"
        />
      </div>
    ) : (
      <div class="my-3 h-36 rounded-xl bg-gradient-to-br from-violet-200 to-sky-200 dark:from-violet-900/60 dark:to-sky-900/60" />
    )
  }

  <div>
    <h2 class="text-lg font-semibold text-[var(--color-fg)]">{title} →</h2>
    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-[var(--color-muted)]">{summary}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        tags.slice(0, 3).map((tag) => (
          <span class="rounded-full bg-[var(--color-bg)] px-2 py-0.5 text-[11px] font-medium text-[var(--color-muted)]">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
</a>

