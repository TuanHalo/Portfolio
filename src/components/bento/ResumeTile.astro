---
import type { Lang } from '@/i18n/ui';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={localizedPath(lang, 'resume')}
  class:list={[
    'bento-tile flex flex-col justify-between p-5 border-transparent bg-emerald-500 text-white dark:bg-emerald-600',
    className,
  ]}
>
  <span class="text-xs text-white/85">{t('home.resume')}</span>
  <div class="mt-4 text-base font-semibold tracking-tight">{t('home.downloadPdf')} ⬇</div>
</a>

