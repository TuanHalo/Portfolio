---
import type { Lang } from '@/i18n/ui';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  count: number;
  class?: string;
}

const { lang, count, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={localizedPath(lang, 'certificates')}
  class:list={['bento-tile flex flex-col justify-between p-5', className]}
>
  <span class="text-xs text-[var(--color-muted)]">{t('home.certificates')}</span>
  <div class="mt-3 flex items-baseline gap-1.5">
    <span class="text-2xl font-bold text-[var(--color-fg)]">{count}</span>
    <span class="text-xs text-[var(--color-muted)]">{t('home.certificatesCount')} →</span>
  </div>
</a>

