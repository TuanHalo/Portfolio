---
import type { Lang } from '@/i18n/ui';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  items: readonly string[];
  class?: string;
}

const { lang, items, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={localizedPath(lang, 'about')}
  class:list={['bento-tile flex flex-col justify-between p-5', className]}
>
  <div class="flex items-center justify-between text-xs text-[var(--color-muted)]">
    <span>{t('home.techStack')}</span>
    <span>{t('home.viewAll')} →</span>
  </div>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {
      items.slice(0, 10).map((item) => (
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-1 text-xs font-medium text-[var(--color-fg)]">
          {item}
        </span>
      ))
    }
  </div>
</a>

