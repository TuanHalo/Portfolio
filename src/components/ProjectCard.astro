---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '@/i18n/ui';
import { localizedPath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  summary: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  tags: readonly string[];
  featured?: boolean;
}

const { lang, slug, title, summary, cover, coverAlt, tags, featured = false } = Astro.props;
const t = useTranslations(lang);
---

<article
  data-project-card
  data-tags={tags.join(',')}
  class="bento-tile flex flex-col overflow-hidden"
>
  <a href={localizedPath(lang, `projects/${slug}`)} class="flex flex-1 flex-col p-5">
    {
      cover ? (
        <div class="mb-4 overflow-hidden rounded-xl border border-[var(--color-border)]">
          <Image src={cover} alt={coverAlt ?? title} class="h-44 w-full object-cover" />
        </div>
      ) : (
        <div class="mb-4 h-44 rounded-xl bg-gradient-to-br from-violet-200 to-sky-200 dark:from-violet-900/60 dark:to-sky-900/60" />
      )
    }

    <div class="flex items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-[var(--color-fg)]">{title}</h2>
      {
        featured && (
          <span class="rounded-full bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-[11px] font-medium text-[var(--color-accent)]">
            {t('projects.featured')}
          </span>
        )
      }
    </div>

    <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{summary}</p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-0.5 text-xs text-[var(--color-muted)]">
            {tag}
          </span>
        ))
      }
    </div>
  </a>
</article>

