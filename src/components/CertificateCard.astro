---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { formatFullDate } from '@/lib/dates';
import { withBase } from '@/lib/url';

interface Props {
  lang: Lang;
  name: string;
  issuer: string;
  date: Date;
  credentialId?: string;
  credentialUrl?: string;
  file?: string;
}

const { lang, name, issuer, date, credentialId, credentialUrl, file } = Astro.props;
const t = useTranslations(lang);
---

<article class="bento-tile flex flex-col justify-between p-5">
  <div>
    <div class="text-xs font-medium text-[var(--color-accent)]">{issuer}</div>
    <h2 class="mt-1 text-base font-semibold text-[var(--color-fg)]">{name}</h2>
    <div class="mt-2 space-y-1 text-xs text-[var(--color-muted)]">
      <div>
        {t('certificates.issued')}: {formatFullDate(date, lang)}
      </div>
      {
        credentialId && (
          <div>
            {t('certificates.credentialId')}: <span class="font-mono">{credentialId}</span>
          </div>
        )
      }
    </div>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium">
    {
      file && (
        <a
          href={withBase(file)}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-[var(--color-fg)] px-3 py-1.5 text-[var(--color-tile)] transition hover:opacity-90"
        >
          {t('certificates.viewFile')} ↗
        </a>
      )
    }
    {
      credentialUrl && (
        <a
          href={credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-[var(--color-border)] px-3 py-1.5 text-[var(--color-fg)] transition hover:border-[var(--color-accent)]"
        >
          {t('certificates.verify')} ↗
        </a>
      )
    }
  </div>
</article>

