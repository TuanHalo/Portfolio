{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Collection",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "category",
      "items"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "category": {
        "type": "object",
        "required": [
          "en",
          "vi"
        ],
        "additionalProperties": false,
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "vi": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
