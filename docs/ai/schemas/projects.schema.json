{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project MDX Frontmatter",
  "type": "object",
  "required": [
    "title",
    "summary",
    "tags",
    "date"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "translation": {
      "type": "string",
      "enum": [
        "human",
        "machine"
      ],
      "default": "human"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demo": {
          "type": "string",
          "format": "uri"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
