{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blog Post MDX Frontmatter",
  "type": "object",
  "required": [
    "title",
    "description",
    "date"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "translation": {
      "type": "string",
      "enum": [
        "human",
        "machine"
      ],
      "default": "human"
    }
  }
}
